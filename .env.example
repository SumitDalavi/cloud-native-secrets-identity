# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: cloud-native-secrets-identity
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - Local mock secrets provider with mock SPIFFE/SPIRE workload identities.
#
# TIER 2 / TIER 3: PRODUCTION HASHICORP VAULT & SPIRE
# - Connect to production Vault server and SPIFFE agent socket.

VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_ROLE=demo-app
SECRET_PATH=secret/data/demo
SPIFFE_ENDPOINT_SOCKET=/run/spire/sockets/agent.sock
PORT=8080
